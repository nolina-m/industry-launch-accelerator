# Optional access keys for Industry Launch Accelerator.
#
# HOW TO USE THIS FILE
# 1. Setup copies this file to a new file called .env (in the same folder).
#    Your .env stays on your computer: it is never shared or uploaded.
# 2. Most data sources work without any key. Each key below switches on one
#    more source. All of them are free; each line says where to sign up.
# 3. Paste your key after the = sign, with no spaces or quotes. Save the file.
# 4. Run the source check again to see what's switched on:
#      macOS:   .venv/bin/python scripts/connectors/check.py
#      Windows: .venv\Scripts\python.exe scripts\connectors\check.py

# ---------------------------------------------------------------------------
# Your contact email. SEC EDGAR (company filings) asks every user of its data
# service to identify themselves. It is sent only to SEC, in each request.
ILA_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Free keys that switch on a source (it's off until you add the key)

# U.S. Census Bureau: business counts, employment, demographics
# Sign up: https://api.census.gov/data/key_signup.html (key arrives by email)
CENSUS_API_KEY=

# FRED (Federal Reserve Bank of St. Louis): economic time series
# Sign up: https://fredaccount.stlouisfed.org/apikeys (create a free account, then "Request API Key")
FRED_API_KEY=

# Regulations.gov: federal dockets and public comments
# Sign up: https://open.gsa.gov/api/regulationsgov/ (an api.data.gov key; arrives by email)
REGULATIONS_GOV_API_KEY=

# Congress.gov: US bills and their status
# Sign up: https://api.congress.gov/sign-up/ (an api.data.gov key; you can reuse the same key as above)
CONGRESS_GOV_API_KEY=

# SAM.gov: federal contract opportunities
# Sign up: create a SAM.gov account, then go to https://sam.gov/profile/details and request a "Public API Key"
SAM_GOV_API_KEY=

# Currents API: recent news from many publishers (free plan: 250 requests a day)
# Sign up: https://currentsapi.services/en/register
CURRENTS_API_KEY=

# ---------------------------------------------------------------------------
# Optional keys that raise limits on sources that already work without one

# GitHub: more searches per minute. Create a token with no extra permissions:
# https://github.com/settings/tokens
GITHUB_TOKEN=

# BLS (Bureau of Labor Statistics): more queries per day
# Sign up: https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# openFDA: more requests per day
# Sign up: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
